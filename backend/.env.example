# Copier ce fichier en ".env" et renseigner de vraies valeurs.
# Ne jamais committer le fichier ".env" réel (voir .gitignore).

PORT=4000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_campus
DB_USER=postgres
DB_PASSWORD=changeme

# Sécurité
JWT_SECRET=change-this-to-a-long-random-string

# Optionnel : clé partagée par défaut à utiliser côté firmware ESP32
# (chaque borne a en réalité sa propre clé, stockée dans la table `devices`)
DEFAULT_DEVICE_KEY=demo-device-key-please-change
